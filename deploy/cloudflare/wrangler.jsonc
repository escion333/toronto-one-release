{
  "main": "worker.mjs",
  "containers": [
    {
      "images": {
        "base": {
          "image": "registry.cloudflare.com/2d1132aadb6f2dd369f0b914b2df9678/toronto-one-remote@sha256:3584c2ae85edc5a1d21988bd75ef7a92adab88f7e7db9914d52de2903e82edd8",
        },
      },
      "class_name": "TorontoOne",
      "scheduling_policy": "durable_object",
    },
  ],
  "name": "toronto-one",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "observability": {
    "enabled": false,
  },
  "routes": [
    {
      "pattern": "tomsanee.com/toronto-one*",
      "zone_name": "tomsanee.com",
    },
    {
      "pattern": "www.tomsanee.com/toronto-one*",
      "zone_name": "tomsanee.com",
    },
  ],
  "vars": {
    "AI_GATEWAY_MODEL": "openai/gpt-6.1-sol",
    "KEEP_AWAKE_UNTIL": "2026-10-27T12:50:40.350Z",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "TorontoOne",
      },
    ],
  },
  "exports": {
    "TorontoOne": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
