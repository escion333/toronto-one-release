{
  "name": "toronto-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node --run format:check && node --run lint && node --run typecheck && node --run test && node --run build",
    "test": "node --test tests/*.test.ts",
    "browser:install": "playwright install chromium",
    "test:live": "node --env-file=.env.local scripts/verify-ai.mts",
    "dev:server": "node --env-file=.env.local server.mjs",
    "deploy": "node scripts/deploy.mts",
    "deploy:check": "node scripts/deploy.mts --check"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.157",
    "@novnc/novnc": "1.7.0",
    "ai": "7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "playwright": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/novnc__novnc": "1.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@10.34.8",
  "description": "Toronto One \u2014 a local demonstration of a Toronto municipal concierge.",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10.34.8 <11"
  },
  "type": "module"
}
